# .env in practice: copy this file to .env, fill in real values, never commit .env.
#
#   cp env.example .env
#   uv run python -c "from dotenv import dotenv_values; print(dotenv_values('.env'))"
#
# .env is in .gitignore. This example is committed so everyone knows which
# variables exist. (It is called env.example without the dot because some
# agent guardrails refuse to touch anything that looks like a real .env.)
# Tokens for the provider CLIs are NOT needed here: `claude`, `codex`,
# `gemini` and `copilot` store their own login in the keychain.

# Who is playing (the CLI reads vibe.toml; this is for your own scripts)
VIBE_PLAYER=Lotte

# A GitHub token only if a script needs the API without `gh auth login`.
# Scope: repo. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Where the vault lives when it is not inside this repo (optional)
VIBE_VAULT=
