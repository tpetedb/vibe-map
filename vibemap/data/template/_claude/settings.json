{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/auth*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Edit(./config.toml)",
      "Write(./config.toml)"
    ],
    "defaultMode": "default"
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && mkdir -p backups && cp -R workspace/data \"backups/data-$(date +%Y%m%d-%H%M%S)-$$\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
