{
  "permissions": {
    "deny": [
      "mcp__memory__read_graph"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/tools/board.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" read",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && mkdir -p backups && cp -R workspace/data \"backups/data-$(date +%Y%m%d-%H%M%S)-$$\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/tools/work.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook pre-tool",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/tools/work.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook stop",
            "timeout": 1800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/tools/work.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook stop",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
